Enum user_role {
  admin
  member
}

Table users {
  id int [pk, increment]
  username varchar(191) [not null, unique]
  password_hash varchar(255) [not null]
  role user_role [not null, note: 'admin atau member']
  full_name varchar(255) [not null]
  profile_photo varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table categories {
  id int [pk, increment]
  name varchar(255) [not null, unique]
  slug varchar(280) [not null, unique]
  created_at datetime
  updated_at timestamp
}

Table articles {
  id int [pk, increment]
  category_id int [not null]
  title varchar(255) [not null]
  slug varchar(280) [not null, unique]
  body mediumtext [not null]
  image_path varchar(255) [not null]
  published_at datetime
  created_at timestamp
  updated_at timestamp

  indexes {
    (category_id, published_at) [name: 'idx_articles_category_published']
    published_at [name: 'idx_articles_published']
  }
}

Table comments {
  id int [pk, increment]
  article_id int [not null]
  name varchar(255) [not null]
  body text [not null]
  created_at datetime

  indexes {
    (article_id, created_at) [name: 'idx_comments_article_created']
  }
}

Table comment_replies {
  id int [pk, increment]
  comment_id int [not null]
  name varchar(255) [not null]
  body text [not null]
  created_at datetime

  indexes {
    (comment_id, created_at) [name: 'idx_comment_replies_parent']
  }
}

Ref: categories.id < articles.category_id [delete: restrict, update: cascade]
Ref: articles.id < comments.article_id [delete: cascade, update: cascade]
Ref: comments.id < comment_replies.comment_id [delete: cascade, update: cascade]
